# For local development you do not need to copy this file by hand: `npm run dev`
# runs scripts/ensure-dev-env.mjs first, which creates .env with these keys
# (and a freshly generated ADMIN_SESSION_SECRET) if they are missing.
# Production must still set both values in the host environment.

DATABASE_URL="file:./dev.db"

# Required — signs admin login sessions. Generate a real random value for each
# environment (dev, production); never reuse or commit the actual value.
# e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=""

# Optional — the public origin the site is served from. Used for canonical
# URLs, Open Graph tags, robots.txt and sitemap.xml, and to allow admin Server
# Action requests through Next.js' origin check.
# Leave unset in production: it defaults to https://ojaskaraabuilders.com.
# Set it only for staging/preview hosts, e.g. SITE_URL="https://staging.example.com"
SITE_URL=""
