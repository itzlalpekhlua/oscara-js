{
  "name": "ojaskaraa-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-dev-env.mjs",
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "start": "node scripts/link-persistent-storage.mjs && next start",
    "lint": "next lint",
    "db:push": "prisma db push --schema=backend/prisma/schema.prisma",
    "db:seed": "tsx backend/prisma/seed.ts",
    "admin:create": "tsx scripts/create-admin-user.ts",
    "postinstall": "prisma generate --schema=backend/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^11.11.9",
    "next": "16.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "tsx backend/prisma/seed.ts",
    "schema": "backend/prisma/schema.prisma"
  }
}
